# Copy to .env
MODSEC_RULE_ENGINE=DetectionOnly   # DetectionOnly = log only, On = block, Off = disabled
PARANOIA=1                         # 1-4, higher = more rules, more false positives
ANOMALY_INBOUND=5
ANOMALY_OUTBOUND=4
MODSEC_AUDIT_ENGINE=RelevantOnly   # On = log every request
DVWA_SECURITY=low
MYSQL_ROOT_PASSWORD=rootpass
